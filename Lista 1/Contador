public class Contador {
    private int valor;

    public Contador() {
        this.valor = 0;
    }

    // a) zerar
    public void zerar() {
        this.valor = 0;
    }

    // b) incrementar
    public void incrementar() {
        this.valor++;
    }

    // c) retornar o valor do contador
    public int getValor() {
        return this.valor;
    }
}