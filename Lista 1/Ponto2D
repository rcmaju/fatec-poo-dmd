public class Ponto2D {
    private double x;
    private double y;

    // a.i) Construtor default (origem)
    public Ponto2D() {
        this.x = 0.0;
        this.y = 0.0;
    }

    // a.ii) Construtor com coordenadas
    public Ponto2D(double x, double y) {
        this.x = x;
        this.y = y;
    }

    // a.iii) Construtor a partir de outro ponto
    public Ponto2D(Ponto2D outro) {
        this.x = outro.getX();
        this.y = outro.getY();
    }

    // b) Getters e Setters
    public double getX() { return x; }
    public void setX(double x) { this.x = x; }

    public double getY() { return y; }
    public void setY(double y) { this.y = y; }

    // c) Métodos sobrecarregados de movimentação
    public void mover() {
        this.x = 0.0;
        this.y = 0.0;
    }

    public void mover(double x, double y) {
        this.x = x;
        this.y = y;
    }

    public void mover(Ponto2D outro) {
        this.x = outro.getX();
        this.y = outro.getY();
    }

    // d) Comparação semântica (equals)
    @Override
    public boolean equals(Object obj) {
        if (this == obj) return true;
        if (obj == null || getClass() != obj.getClass()) return false;
        Ponto2D outro = (Ponto2D) obj;
        return Double.compare(outro.x, x) == 0 && Double.compare(outro.y, y) == 0;
    }

    // e) Representação como String
    @Override
    public String toString() {
        return "(" + x + ", " + y + ")";
    }

    // Método para calcular distância até outro ponto
    public double distancia(Ponto2D outro) {
        double dx = outro.getX() - this.x;
        double dy = outro.getY() - this.y;
        return Math.sqrt(Math.pow(dx, 2) + Math.pow(dy, 2));
    }

    // f) Criação de um novo ponto no mesmo local (clone)
    public Ponto2D clonar() {
        return new Ponto2D(this.x, this.y);
    }
}